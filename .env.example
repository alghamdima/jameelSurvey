APP_NAME="عبد اللطيف جميل للتمويل - منصة الاستبيانات"
APP_ENV=production
SURVEY_DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/surveys.db
DEFAULT_LOCALE=ar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CSV is imported using python -m app.cli.bootstrap before starting workers.
EMPLOYEE_CSV_PATH=
ADMIN_SESSION_TTL_SECONDS=28800
PARTICIPATION_TTL_SECONDS=43200
